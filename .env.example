# Copy to .env and fill in ONE of these. .env is gitignored; this template is committed.
# Loaded automatically by bench/run.py (variables already set in your shell win).

# API billing:
ANTHROPIC_API_KEY=

# Or your Claude subscription (Pro/Max/Team/Enterprise): run `claude setup-token`
# in a terminal and paste the token here. Used when ANTHROPIC_API_KEY is empty.
CLAUDE_CODE_OAUTH_TOKEN=
